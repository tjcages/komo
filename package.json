{
  "name": "komo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter komo-site build",
    "test": "pnpm --filter @tjcages/komo test",
    "typecheck": "pnpm -r typecheck",
    "size": "pnpm --filter @tjcages/komo size",
    "dev": "pnpm --filter komo-site dev",
    "dev:api": "pnpm --filter @tjcages/komo dev:api",
    "deploy:site": "pnpm --filter komo-site run deploy",
    "deploy:api": "pnpm --filter @tjcages/komo build:setup && wrangler deploy --config packages/komo/server/hosted.jsonc",
    "preview:deploy": "pnpm preview:site",
    "preview:site": "pnpm build && wrangler versions upload --config packages/komo-site/wrangler.jsonc --preview-alias \"$(git rev-parse --abbrev-ref HEAD | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+|-+$//g')\"",
    "audio:studio": "node videos/audio/serve.mjs",
    "audio:test": "node --test videos/audio/*.test.mjs"
  },
  "devDependencies": {
    "cuelume": "0.2.2",
    "node-web-audio-api": "2.2.0",
    "prettier": "3.8.1",
    "wrangler": "4.136.3"
  }
}
