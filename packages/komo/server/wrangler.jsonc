{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "komo-local",
  "main": "index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "komo-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PROJECTS": "{\"komo\": {\"repo\": \"tjcages/komo\", \"origins\": [\"http://localhost:*\", \"http://127.0.0.1:*\"]}}",
    "GOOGLE_CLIENT_ID": "",
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": ""
  }
}
