{
  "name": "komo-api",
  "main": "index.ts",
  // Clients reach the API through komo.offbr.co (the komo-site Worker's
  // KOMO_API binding); the original workers.dev address is retired.
  "workers_dev": false,
  "compatibility_date": "2026-07-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "944ca70087298faa2e84783db46162c5",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "EDGE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {
    "PROJECTS": "{\"komo-landing-demo\":{\"repo\":\"tjcages/komo\",\"origins\":[\"https://komo.offbr.co\",\"https://komo-site-preview.lue-branch-comments-review.pages.dev\",\"http://localhost:4340\",\"http://127.0.0.1:4340\",\"https://cad114dc.lue-branch-comments-review.pages.dev\",\"https://0d2ff8f7.lue-branch-comments-review.pages.dev\",\"https://823d850b.lue-branch-comments-review.pages.dev\",\"https://preview.komo-wb5.pages.dev\",\"https://*-komo-site.off-brand.workers.dev\"],\"allowGuests\":true,\"writesPerDay\":1000,\"retainedCommentsPerUser\":3}}",
    "KOMO_HOSTED": "true",
    "GOOGLE_CLIENT_ID": "416068916728-u8si291t8trkri7e0ov09ab7rnb6329c.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "",
    "GITHUB_CLIENT_SECRET": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "komo-hosted",
      "database_id": "e8bc9e3c-830d-411d-9fa9-b824605d36ed",
      "migrations_dir": "migrations"
    }
  ]
}
